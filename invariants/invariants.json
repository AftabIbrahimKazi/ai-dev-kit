[
	{
		"id": "R1",
		"rule": "The gate accepts only when the mean gain exceeds min-gain; a tie rejects.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R1",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "if (!(gain > minGain))",
			"replace": "if (!(gain >= minGain))"
		}
	},
	{
		"id": "R2",
		"rule": "An accept never hides a task that got worse by more than the tolerance.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R2",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "cand[t] < base[t] - tol",
			"replace": "cand[t] < base[t] - tol - 0.5"
		}
	},
	{
		"id": "R3",
		"rule": "A missing, non-numeric or non-finite score, or an empty baseline, rejects.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R3",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "|| !Number.isFinite(cand[t])",
			"replace": "|| false"
		}
	},
	{
		"id": "R4",
		"rule": "Raising a candidate score never turns an accept into a reject.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R4",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "cand[t] < base[t] - tol",
			"replace": "Math.abs(cand[t] - base[t]) > tol"
		}
	},
	{
		"id": "R5",
		"rule": "The reported means and gain equal the true averages.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R5",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "/ v.length",
			"replace": "/ (v.length + 1)"
		}
	},
	{
		"id": "R6",
		"rule": "Exit code is 0 on accept, 1 on reject, 2 on bad usage.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R6",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "res.action === 'accept' ? 0 : 1",
			"replace": "res.action === 'accept' ? 1 : 0"
		}
	},
	{
		"id": "R7",
		"rule": "--allow-regress skips the per-task rule but still needs a mean gain.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R7",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "o.noRegression = false",
			"replace": "o.noRegression = true"
		}
	},
	{
		"id": "R8",
		"rule": "The verdict equals the plain definition: accept iff gain > min-gain and (no-regression off or no task worse than tolerance), with defaults 0.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R8",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "if (!(gain > minGain))",
			"replace": "if (!(gain > minGain + 0.01))"
		}
	},
	{
		"id": "R9",
		"rule": "The --tolerance and --min-gain flags change the verdict.",
		"covers": [
			"skills/meta/ab-gate.js"
		],
		"check": "node invariants/ab-gate.check.js R9",
		"mutate": {
			"file": "skills/meta/ab-gate.js",
			"find": "o.minGain = Number(argv[++i])",
			"replace": "o.minGain = -Number(argv[++i])"
		}
	}
]
